# On your own computer you do not need this file: save your Claude plan token or API key on the page,
# under "Claude connection". Otherwise copy it to .env and fill it in. The .env file is never committed.

# An Anthropic API key, billed per run. Needed on a copy that other people can reach, such as Render.
# Get one at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Optional, only on your own computer: run on your Claude Pro or Max plan through Claude Code.
# Run `claude setup-token`, sign in, and paste the token it prints. Without it, Claude Code's own login is used.
# CLAUDE_CODE_OAUTH_TOKEN=

# Optional, for a copy that other people can reach. When APP_PASSWORD is set,
# the browser asks for this username and password before showing anything.
# APP_USERNAME=veda
# APP_PASSWORD=

# Optional. Folder where runs are kept (default: ./jobs). On a host, point it at a persistent disk.
# JOBS_DIR=

# Optional. How many runs may be in progress at once (default: 3).
# MAX_ACTIVE_RUNS=3

# Optional. A Postgres connection string (for example from https://neon.com). Every run is also
# kept in this database, so runs survive a host that wipes its files.
# DATABASE_URL=
