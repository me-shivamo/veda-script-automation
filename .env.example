# Copy this file to .env and fill in your key. The .env file is never committed.

# Required. Get one at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Optional, for a copy that other people can reach. When APP_PASSWORD is set,
# the browser asks for this username and password before showing anything.
# APP_USERNAME=veda
# APP_PASSWORD=

# Optional. Folder where runs are kept (default: ./jobs). On a host, point it at a persistent disk.
# JOBS_DIR=

# Optional. How many runs may be in progress at once (default: 3).
# MAX_ACTIVE_RUNS=3

# Optional. A Postgres connection string (for example from https://neon.com). Every run is also
# kept in this database, so runs survive a host that wipes its files.
# DATABASE_URL=
